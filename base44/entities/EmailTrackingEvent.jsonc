{
  "name": "EmailTrackingEvent",
  "type": "object",
  "properties": {
    "leadId": {
      "type": "string",
      "title": "Lead ID"
    },
    "sendId": {
      "type": "string",
      "title": "Send ID (unique per email send)"
    },
    "templateId": {
      "type": "string",
      "title": "Email Template ID (for matching opens to templates)"
    },
    "templateName": {
      "type": "string",
      "title": "Email Template Name (for display)"
    },
    "eventType": {
      "type": "string",
      "title": "Event Type",
      "enum": [
        "open",
        "click",
        "qualify_visit"
      ]
    },
    "url": {
      "type": "string",
      "title": "Clicked URL (for click events)"
    },
    "userAgent": {
      "type": "string",
      "title": "User Agent"
    },
    "ipAddress": {
      "type": "string",
      "title": "IP Address"
    },
    "trackedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Tracked At"
    }
  },
  "required": [
    "leadId",
    "eventType"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}