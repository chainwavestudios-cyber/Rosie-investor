{
  "name": "RateDropMailer",
  "type": "object",
  "properties": {
    "leadId": {
      "type": "string",
      "title": "Contact Card ID"
    },
    "leadNumber": {
      "type": "string",
      "title": "Lead Number"
    },
    "noticeId": {
      "type": "string",
      "title": "Notice ID (printed on the mailer as the Plan Number)"
    },
    "recipientName": {
      "type": "string",
      "title": "Recipient Name"
    },
    "email": {
      "type": "string",
      "title": "Email on the Contact Card (campaign recipient)"
    },
    "state": {
      "type": "string",
      "title": "Recipient State"
    },
    "debtAmount": {
      "type": "number",
      "title": "Debt Amount ($)"
    },
    "savingsAmount": {
      "type": "number",
      "title": "Savings Shown ($)"
    },
    "phone": {
      "type": "string",
      "title": "Phone Printed on the Mailer (incoming AI agent line)"
    },
    "templateName": {
      "type": "string",
      "title": "Template Used"
    },
    "html": {
      "type": "string",
      "title": "Generated Digital Mailer (email-safe HTML)",
      "format": "textarea"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Generated At"
    },
    "lastSentAt": {
      "type": "string",
      "format": "date-time",
      "title": "Last Emailed At"
    }
  },
  "required": [
    "leadId"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}