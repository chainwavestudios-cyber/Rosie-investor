{
  "name": "Objection",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Objection Title"
    },
    "triggerPhrases": {
      "type": "string",
      "title": "Trigger Phrases (JSON array \u2014 customer says any of these)",
      "format": "textarea"
    },
    "responseText": {
      "type": "string",
      "title": "Agent Response (read this to the customer)",
      "format": "textarea"
    },
    "mindset": {
      "type": "string",
      "title": "Customer Mindset",
      "format": "textarea"
    },
    "goal": {
      "type": "string",
      "title": "Agent Goal",
      "format": "textarea"
    },
    "priority": {
      "type": "string",
      "title": "Priority (determines the live-call action)",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "enabled": {
      "type": "boolean",
      "title": "Enabled (active in live calls)",
      "default": true
    },
    "sortOrder": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "title",
    "triggerPhrases",
    "responseText"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}