{
  "name": "DebtQAHistory",
  "type": "object",
  "properties": {
    "leadId": {
      "type": "string",
      "title": "Lead ID"
    },
    "leadName": {
      "type": "string",
      "title": "Lead Name (for display)"
    },
    "question": {
      "type": "string",
      "title": "Question"
    },
    "answer": {
      "type": "string",
      "title": "Answer",
      "format": "textarea"
    },
    "askedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Asked At"
    },
    "source": {
      "type": "string",
      "title": "Source",
      "enum": [
        "auto",
        "manual",
        "transcript"
      ],
      "default": "auto"
    }
  },
  "required": [
    "leadId",
    "question"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}