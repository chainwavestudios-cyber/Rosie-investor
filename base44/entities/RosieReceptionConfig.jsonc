{
  "name": "RosieReceptionConfig",
  "type": "object",
  "properties": {
    "configName": {
      "type": "string",
      "default": "corporate"
    },
    "isActive": {
      "type": "boolean",
      "default": false
    },
    "phoneNumber": {
      "type": "string",
      "default": "+18662908994"
    },
    "notificationEmail": {
      "type": "string",
      "default": "PR@Rosieai.tech"
    },
    "calendarId": {
      "type": "string"
    },
    "calendarTimezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "meetingDurationMinutes": {
      "type": "number",
      "default": 30
    },
    "updatedBy": {
      "type": "string"
    },
    "llmModel": {
      "type": "string",
      "default": "claude-haiku-4-5-20251001"
    },
    "ttsProvider": {
      "type": "string",
      "default": "cartesia"
    },
    "cartesiaVoiceId": {
      "type": "string",
      "default": "a33f7a4c-100f-41cf-a1fd-5822e8fc253f"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": [
    "configName"
  ]
}
