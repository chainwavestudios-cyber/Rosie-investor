{
  "name": "DebtLead",
  "type": "object",
  "properties": {
    "leadNumber": {
      "type": "string",
      "title": "Lead Number (e.g. #00001)"
    },
    "firstName": {
      "type": "string",
      "title": "First Name"
    },
    "lastName": {
      "type": "string",
      "title": "Last Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zip": {
      "type": "string",
      "title": "Zip"
    },
    "debtAmount": {
      "type": "number",
      "title": "Total Debt Amount ($)"
    },
    "creditorCount": {
      "type": "number",
      "title": "Number of Creditors"
    },
    "creditors": {
      "type": "string",
      "title": "Creditors List",
      "format": "textarea"
    },
    "debtLedgerJson": {
      "type": "string",
      "title": "Debt Ledger (JSON)",
      "format": "textarea"
    },
    "billsJson": {
      "type": "string",
      "title": "Monthly Bills (JSON)",
      "format": "textarea"
    },
    "employmentStatus": {
      "type": "string",
      "title": "Employment Status",
      "enum": [
        "employed",
        "self-employed",
        "unemployed",
        "retired",
        "disabled"
      ]
    },
    "monthlyIncome": {
      "type": "number",
      "title": "Monthly Income ($)"
    },
    "creditScore": {
      "type": "number",
      "title": "Credit Score"
    },
    "behindOnPayments": {
      "type": "boolean",
      "title": "Behind on Payments",
      "default": false
    },
    "monthsBehind": {
      "type": "number",
      "title": "Months Behind"
    },
    "programEnrolled": {
      "type": "boolean",
      "title": "Enrolled in Program",
      "default": false
    },
    "enrollmentDate": {
      "type": "string",
      "format": "date",
      "title": "Enrollment Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "enrolled",
        "declined",
        "completed",
        "callback"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    },
    "profileJson": {
      "type": "string",
      "title": "AI Profile (JSON)",
      "format": "textarea"
    },
    "lastCallAt": {
      "type": "string",
      "format": "date-time",
      "title": "Last Call At"
    },
    "callCount": {
      "type": "number",
      "title": "Call Count",
      "default": 0
    },
    "intentScore": {
      "type": "number",
      "title": "Latest Intent Score"
    },
    "animalType": {
      "type": "string",
      "title": "Animal Type",
      "enum": [
        "duck",
        "cow",
        "unknown"
      ]
    },
    "transcriptJson": {
      "type": "string",
      "title": "Last Call Transcript (JSON)",
      "format": "textarea"
    },
    "callbackAt": {
      "type": "string",
      "format": "date-time",
      "title": "Callback At"
    },
    "creditReportPhotoUri": {
      "type": "string",
      "title": "Credit Report Photo URI"
    },
    "creditReportAnalyzedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Credit Report Analyzed At"
    },
    "hardshipWhen": {
      "type": "string",
      "title": "Hardship \u2014 When It Started",
      "format": "textarea"
    },
    "hardshipWhy": {
      "type": "string",
      "title": "Hardship \u2014 Why It Happened",
      "format": "textarea"
    },
    "hardshipHow": {
      "type": "string",
      "title": "Hardship \u2014 How It Impacted Finances",
      "format": "textarea"
    },
    "cosignersJson": {
      "type": "string",
      "title": "Co-Signers (JSON)",
      "format": "textarea"
    },
    "debtCoachOwner": {
      "type": "string",
      "title": "Debt Coach Owner (username)"
    },
    "nextCallBriefing": {
      "type": "string",
      "title": "Next Call Briefing (pre-call report)",
      "format": "textarea"
    },
    "nextCallBriefingAt": {
      "type": "string",
      "format": "date-time",
      "title": "Next Call Briefing Generated At"
    }
  },
  "required": [
    "firstName",
    "lastName"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}