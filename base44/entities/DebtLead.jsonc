{
  "name": "DebtLead",
  "type": "object",
  "properties": {
    "leadNumber": {
      "type": "string",
      "title": "Lead Number (e.g. #00001)"
    },
    "firstName": {
      "type": "string",
      "title": "First Name"
    },
    "lastName": {
      "type": "string",
      "title": "Last Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zip": {
      "type": "string",
      "title": "Zip"
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date",
      "title": "Date of Birth"
    },
    "debtAmount": {
      "type": "number",
      "title": "Total Debt Amount ($)"
    },
    "creditorCount": {
      "type": "number",
      "title": "Number of Creditors"
    },
    "creditors": {
      "type": "string",
      "title": "Creditors List",
      "format": "textarea"
    },
    "debtLedgerJson": {
      "type": "string",
      "title": "Debt Ledger (JSON)",
      "format": "textarea"
    },
    "nonAcceptedCreditorsJson": {
      "type": "string",
      "title": "Non-Accepted Creditors (JSON)",
      "format": "textarea"
    },
    "billsJson": {
      "type": "string",
      "title": "Monthly Bills (JSON)",
      "format": "textarea"
    },
    "employmentStatus": {
      "type": "string",
      "title": "Employment Status",
      "enum": [
        "employed",
        "self-employed",
        "unemployed",
        "retired",
        "disabled"
      ]
    },
    "monthlyIncome": {
      "type": "number",
      "title": "Monthly Income ($)"
    },
    "creditScore": {
      "type": "number",
      "title": "Credit Score"
    },
    "age": {
      "type": "number",
      "title": "Age"
    },
    "householdIncome": {
      "type": "number",
      "title": "Household Income ($)"
    },
    "homeValue": {
      "type": "number",
      "title": "Home Value ($)"
    },
    "homeEquity": {
      "type": "number",
      "title": "Home Equity ($)"
    },
    "tradelines": {
      "type": "number",
      "title": "Tradelines (count)"
    },
    "behindOnPayments": {
      "type": "boolean",
      "title": "Behind on Payments",
      "default": false
    },
    "monthsBehind": {
      "type": "number",
      "title": "Months Behind"
    },
    "programEnrolled": {
      "type": "boolean",
      "title": "Enrolled in Program",
      "default": false
    },
    "enrollmentDate": {
      "type": "string",
      "format": "date",
      "title": "Enrollment Date"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "enrolled",
        "declined",
        "completed",
        "callback"
      ],
      "default": "new"
    },
    "isHotLead": {
      "type": "boolean",
      "title": "Hot Lead (tagged by coach for priority follow-up)",
      "default": false
    },
    "hotLeadTaggedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Hot Lead Tagged At"
    },
    "hotLeadTaggedBy": {
      "type": "string",
      "title": "Hot Lead Tagged By (username)"
    },
    "migratedFromFronter": {
      "type": "boolean",
      "title": "Migrated From Fronter (auto-created on successful transfer)",
      "default": false
    },
    "migratedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Migrated At (when fronter transferred this lead)"
    },
    "migratedBy": {
      "type": "string",
      "title": "Migrated By (fronter username)"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    },
    "profileJson": {
      "type": "string",
      "title": "AI Profile (JSON)",
      "format": "textarea"
    },
    "aiPopulateLogJson": {
      "type": "string",
      "title": "AI Populate Log (JSON array of {fieldName, oldValue, newValue, timestamp, isFinal})",
      "format": "textarea"
    },
    "lastCallAt": {
      "type": "string",
      "format": "date-time",
      "title": "Last Call At"
    },
    "callCount": {
      "type": "number",
      "title": "Call Count",
      "default": 0
    },
    "intentScore": {
      "type": "number",
      "title": "Latest Intent Score"
    },
    "dealScore": {
      "type": "number",
      "title": "Deal Score (0-100, 100 = enrolled)",
      "default": 0
    },
    "animalType": {
      "type": "string",
      "title": "Animal Type",
      "enum": [
        "duck",
        "cow",
        "unknown"
      ]
    },
    "transcriptJson": {
      "type": "string",
      "title": "Last Call Transcript (JSON)",
      "format": "textarea"
    },
    "callbackAt": {
      "type": "string",
      "format": "date-time",
      "title": "Callback At"
    },
    "creditReportPhotoUri": {
      "type": "string",
      "title": "Credit Report Photo URI"
    },
    "creditReportAnalyzedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Credit Report Analyzed At"
    },
    "hardshipWhen": {
      "type": "string",
      "title": "Hardship \u2014 When It Started",
      "format": "textarea"
    },
    "hardshipWhy": {
      "type": "string",
      "title": "Hardship \u2014 Why It Happened",
      "format": "textarea"
    },
    "hardshipHow": {
      "type": "string",
      "title": "Hardship \u2014 How It Impacted Finances",
      "format": "textarea"
    },
    "cosignersJson": {
      "type": "string",
      "title": "Co-Signers (JSON)",
      "format": "textarea"
    },
    "debtCoachOwner": {
      "type": "string",
      "title": "Debt Coach Owner (username)"
    },
    "nextCallBriefing": {
      "type": "string",
      "title": "Next Call Briefing (pre-call report)",
      "format": "textarea"
    },
    "nextCallBriefingAt": {
      "type": "string",
      "format": "date-time",
      "title": "Next Call Briefing Generated At"
    },
    "closingProgressJson": {
      "type": "string",
      "title": "Closing Checklist Progress (JSON \u2014 step keys checked, saved across calls)",
      "format": "textarea"
    },
    "closingProgressUpdatedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Closing Progress Last Saved At"
    },
    "deletedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Soft-Deleted At (set when lead is marked for deletion; permanently removed after 7 days)"
    },
    "deletedBy": {
      "type": "string",
      "title": "Soft-Deleted By (username)"
    },
    "appointmentDate": {
      "type": "string",
      "format": "date-time",
      "title": "Appointment Date/Time (Google Calendar event start)"
    },
    "appointmentTitle": {
      "type": "string",
      "title": "Appointment Title"
    },
    "appointmentEventId": {
      "type": "string",
      "title": "Google Calendar Event ID"
    },
    "appointmentEventHtmlLink": {
      "type": "string",
      "title": "Google Calendar Event HTML Link"
    },
    "appointmentConfirmed": {
      "type": "boolean",
      "title": "Appointment Confirmed by Client",
      "default": false
    },
    "appointmentConfirmedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Appointment Confirmed At"
    },
    "appointmentChangeRequested": {
      "type": "boolean",
      "title": "Client Requested Appointment Change",
      "default": false
    },
    "appointmentChangeRequestedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Appointment Change Requested At"
    },
    "nightBeforeReminderSentAt": {
      "type": "string",
      "format": "date-time",
      "title": "Night-Before Reminder Email Sent At"
    },
    "hourBeforeReminderSentAt": {
      "type": "string",
      "format": "date-time",
      "title": "1-Hour Reminder Email Sent At"
    },
    "apptNightBeforeSendId": {
      "type": "string",
      "title": "Night-Before Email Send ID (for tracking)"
    },
    "apptHourBeforeSendId": {
      "type": "string",
      "title": "1-Hour Email Send ID (for tracking)"
    },
    "apptEmailOpenedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Reminder Email Opened At (night-before)"
    },
    "apptBbbClickedAt": {
      "type": "string",
      "format": "date-time",
      "title": "BBB Link Clicked At"
    },
    "apptTrustpilotClickedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Trustpilot Link Clicked At"
    },
    "apptWebsiteClickedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Company Website Link Clicked At"
    },
    "apptHourReminderOpenedAt": {
      "type": "string",
      "format": "date-time",
      "title": "1-Hour Reminder Email Opened At"
    },
    "nightBeforeReminderEnabled": {
      "type": "boolean",
      "title": "Night-Before Reminder Enabled",
      "default": true
    },
    "hourBeforeReminderEnabled": {
      "type": "boolean",
      "title": "1-Hour Reminder Enabled",
      "default": true
    },
    "rescheduleSlotsJson": {
      "type": "string",
      "title": "Reschedule Slots (JSON array of {startISO, label, dayLabel})",
      "format": "textarea"
    },
    "rescheduleToken": {
      "type": "string",
      "title": "Reschedule Security Token (for public rebooking link)"
    },
    "rescheduleSentAt": {
      "type": "string",
      "format": "date-time",
      "title": "Reschedule Email Sent At"
    },
    "rescheduleBookedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Reschedule Booked At (customer selected a new slot)"
    },
    "personalMessageClickedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Personal Message Audio Link Clicked At"
    },
    "personalMessageAudioPlayedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Personal Message Audio Playback Completed At (set by external audio site callback)"
    }
  },
  "required": [
    "firstName",
    "lastName"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}