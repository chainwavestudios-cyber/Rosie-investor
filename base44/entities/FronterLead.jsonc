{
  "name": "FronterLead",
  "type": "object",
  "properties": {
    "leadNumber": {
      "type": "string",
      "title": "Lead Number (e.g. #F0001)"
    },
    "firstName": {
      "type": "string",
      "title": "First Name"
    },
    "lastName": {
      "type": "string",
      "title": "Last Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "phone2": {
      "type": "string",
      "title": "Secondary Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zipCode": {
      "type": "string",
      "title": "Zip Code"
    },
    "preferredCallTime": {
      "type": "string",
      "title": "Best Time to Call"
    },
    "employmentStatus": {
      "type": "string",
      "title": "Employment Status",
      "enum": [
        "employed",
        "self_employed",
        "unemployed",
        "retired",
        "disabled",
        "unknown"
      ],
      "default": "unknown"
    },
    "annualIncome": {
      "type": "number",
      "title": "Annual Income ($)"
    },
    "referralSource": {
      "type": "string",
      "title": "Lead Source / Referral"
    },
    "debtAmount": {
      "type": "number",
      "title": "Amount of Debt ($)"
    },
    "debtTypesJson": {
      "type": "string",
      "title": "Debt Types (JSON array \u2014 Unsecured Credit Card, Unsecured Loans)",
      "format": "textarea"
    },
    "notesLogJson": {
      "type": "string",
      "title": "Notes Log (JSON array of {text, timestamp, author, type})",
      "format": "textarea"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "prospect",
        "lead",
        "transferred",
        "closed_deal",
        "removed"
      ],
      "default": "prospect"
    },
    "assignedTo": {
      "type": "string",
      "title": "Assigned To (fronter username)"
    },
    "assignedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Assigned At"
    },
    "assignedBy": {
      "type": "string",
      "title": "Assigned By (admin username)"
    },
    "callCount": {
      "type": "number",
      "title": "Call Count (max 3 before removal)",
      "default": 0
    },
    "lastCalledAt": {
      "type": "string",
      "format": "date-time",
      "title": "Last Called At"
    },
    "lastCallResult": {
      "type": "string",
      "title": "Last Call Result (no_answer, voicemail, connected, transferred, hung_up, not_interested, interested, appointment)"
    },
    "lastCallDurationSeconds": {
      "type": "number",
      "title": "Last Call Duration (seconds)",
      "default": 0
    },
    "transferredTo": {
      "type": "string",
      "title": "Transferred To (agent name or number)"
    },
    "transferredAt": {
      "type": "string",
      "format": "date-time",
      "title": "Transferred At"
    },
    "closedDealAt": {
      "type": "string",
      "format": "date-time",
      "title": "Closed Deal At (set when lead is marked as closed_deal)"
    },
    "closedDealBy": {
      "type": "string",
      "title": "Closed Deal By (admin username who marked it closed)"
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    },
    "uploadedBy": {
      "type": "string",
      "title": "Uploaded By (admin username)"
    },
    "credsSentAt": {
      "type": "string",
      "format": "date-time",
      "title": "Credentials Sent At"
    },
    "credsSentTemplate": {
      "type": "string",
      "title": "Credentials Template Sent"
    }
  },
  "required": [
    "firstName",
    "lastName",
    "phone"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}