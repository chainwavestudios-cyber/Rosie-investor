{
  "name": "RateDropTemplate",
  "type": "object",
  "properties": {
    "configName": {
      "type": "string",
      "title": "Config Name (singleton key)",
      "default": "default"
    },
    "name": {
      "type": "string",
      "title": "Template Name",
      "default": "DEBT Solutions Rate Drop Notice"
    },
    "documentTitle": {
      "type": "string",
      "title": "Masthead Title (black band across the top)",
      "default": "THE DEBT SOLUTIONS RATE DROP ENGINE"
    },
    "noticeTitle": {
      "type": "string",
      "title": "Notice Title (under the masthead)",
      "default": "OFFICIAL NOTICE OF ELIGIBILITY"
    },
    "deadlineTime": {
      "type": "string",
      "title": "Response Deadline Time (printed after the respond-by date)",
      "default": "5:00 PM PST"
    },
    "addresseeStatus": {
      "type": "string",
      "title": "Account Status (line in the addressee box)",
      "format": "textarea",
      "default": "PENDING REVIEW, UNSECURED REVOLVING CREDIT ACCOUNTS"
    },
    "overviewText": {
      "type": "string",
      "title": "Notice Details & Program Overview \u2014 First Paragraph",
      "format": "textarea",
      "default": "Our system has flagged your file regarding active credit card accounts carrying high interest rates. You have been selected to participate in the Debt Solutions Rate Drop Engine, a program engineered to assist high-balance cardholders in {{state}} in restructuring high-interest unsecured debt. Your File Number {{plan_number}} is on record for this notice."
    },
    "qualifyText": {
      "type": "string",
      "title": "Notice Details & Program Overview \u2014 Second Paragraph",
      "format": "textarea",
      "default": "If you are currently carrying 3 or more active credit card balances, you may qualify for immediate rate reduction strategies designed to target 0% interest terms and significantly lower your monthly outlay, with zero upfront fees."
    },
    "benefitsJson": {
      "type": "string",
      "title": "Key Program Benefits (JSON array of {title, text})",
      "format": "textarea"
    },
    "eligibilityJson": {
      "type": "string",
      "title": "Summary of Eligibility (JSON array of {label, value} \u2014 {{slots}} allowed in the value)",
      "format": "textarea"
    },
    "nextStepsText": {
      "type": "string",
      "title": "Required Next Steps \u2014 Intro Line",
      "format": "textarea",
      "default": "Enrollment spots are limited by regional quotas in Riverside, San Bernardino, and Los Angeles counties. To lock in your eligibility and review your real numbers with a specialist:"
    },
    "nextStepsJson": {
      "type": "string",
      "title": "Required Next Steps (JSON array of strings \u2014 numbered automatically)",
      "format": "textarea"
    },
    "disclaimerText": {
      "type": "string",
      "title": "Confidentiality & Disclaimer (small print at the foot of the notice)",
      "format": "textarea",
      "default": "This notice is confidential and intended solely for {{recipient_name}}. Debt Solutions Inc. is a private company that negotiates directly with credit card issuers on behalf of enrolled consumers. This is not a government program, credit repair service, or loan offer. Services may not be available in all states. Savings shown are estimates based on the balances on file and are not guaranteed; individual results vary with creditor cooperation, program length and the ability to fund a dedicated account. To stop receiving mail from us, call {{phone}}."
    },
    "savingsPercent": {
      "type": "number",
      "title": "Savings Percent (debt reduction shown as savings)",
      "default": 60
    },
    "respondByDays": {
      "type": "number",
      "title": "Respond-By Window (days from notice date)",
      "default": 30
    },
    "ctaPhoneOverride": {
      "type": "string",
      "title": "Phone Override (leave empty to use the incoming AI agent line)"
    },
    "fieldMapJson": {
      "type": "string",
      "title": "Field Map (JSON array of {slot, source})",
      "format": "textarea"
    },
    "mailjetTemplateId": {
      "type": "string",
      "title": "Mailjet Template ID (the template each digital notice is injected into \u2014 created by 'Create in Mailjet')"
    },
    "updatedBy": {
      "type": "string",
      "title": "Last Updated By (username)"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Last Updated At"
    }
  },
  "required": [
    "configName"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}