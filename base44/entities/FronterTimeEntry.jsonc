{
  "name": "FronterTimeEntry",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "title": "Fronter Username"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date (YYYY-MM-DD, Eastern Time)"
    },
    "clockIn": {
      "type": "string",
      "format": "date-time",
      "title": "Clock In Time (active session)"
    },
    "lunchOut": {
      "type": "string",
      "format": "date-time",
      "title": "Lunch Out Time"
    },
    "lunchIn": {
      "type": "string",
      "format": "date-time",
      "title": "Lunch In Time"
    },
    "amBreakOut": {
      "type": "string",
      "format": "date-time",
      "title": "AM Break Out Time"
    },
    "amBreakIn": {
      "type": "string",
      "format": "date-time",
      "title": "AM Break In Time"
    },
    "pmBreakOut": {
      "type": "string",
      "format": "date-time",
      "title": "PM Break Out Time"
    },
    "pmBreakIn": {
      "type": "string",
      "format": "date-time",
      "title": "PM Break In Time"
    },
    "clockOut": {
      "type": "string",
      "format": "date-time",
      "title": "Clock Out Time (active session)"
    },
    "sessionsJson": {
      "type": "string",
      "title": "Prior Sessions (JSON array of {clockIn, clockOut, totalSeconds})",
      "format": "textarea"
    },
    "totalSeconds": {
      "type": "number",
      "title": "Total Worked Seconds (all sessions, lunch + breaks excluded)",
      "default": 0
    }
  },
  "required": [
    "username",
    "date"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}