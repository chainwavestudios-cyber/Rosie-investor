{
  "name": "FronterPerformanceReport",
  "type": "object",
  "properties": {
    "fronterUsername": {
      "type": "string",
      "title": "Fronter Username"
    },
    "fronterName": {
      "type": "string",
      "title": "Fronter Display Name"
    },
    "reportDate": {
      "type": "string",
      "format": "date",
      "title": "Report Date (YYYY-MM-DD, Eastern Time)"
    },
    "shiftPeriod": {
      "type": "string",
      "title": "Shift Period",
      "enum": [
        "AM",
        "PM"
      ]
    },
    "apsScore": {
      "type": "number",
      "title": "Agent Performance Score (0-100)"
    },
    "scoreTier": {
      "type": "string",
      "title": "Score Tier",
      "enum": [
        "green",
        "yellow",
        "red"
      ]
    },
    "totalCalls": {
      "type": "number",
      "title": "Total Calls Audited",
      "default": 0
    },
    "totalTransfers": {
      "type": "number",
      "title": "Total Transfers Initiated",
      "default": 0
    },
    "transferRate": {
      "type": "number",
      "title": "Transfer Rate (%)",
      "default": 0
    },
    "avgCallDurationSeconds": {
      "type": "number",
      "title": "Average Call Duration (seconds)",
      "default": 0
    },
    "shiftStartISO": {
      "type": "string",
      "format": "date-time",
      "title": "Shift Start Time (clock-in)"
    },
    "shiftEndISO": {
      "type": "string",
      "format": "date-time",
      "title": "Shift End Time (clock-out, for PM reports)"
    },
    "reportTimestamp": {
      "type": "string",
      "format": "date-time",
      "title": "Report Generated At"
    },
    "reportMarkdown": {
      "type": "string",
      "title": "Full Report (Markdown)",
      "format": "textarea"
    },
    "highlights": {
      "type": "string",
      "title": "Key Performance Highlights",
      "format": "textarea"
    },
    "coachingPoints": {
      "type": "string",
      "title": "Areas for Coaching & Improvement",
      "format": "textarea"
    },
    "transcriptSpotlight": {
      "type": "string",
      "title": "Transcript Spotlight (Notable Call)",
      "format": "textarea"
    },
    "viewedByFronter": {
      "type": "boolean",
      "title": "Viewed by Fronter",
      "default": false
    },
    "viewedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Viewed At"
    }
  },
  "required": [
    "fronterUsername",
    "reportDate",
    "shiftPeriod"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}