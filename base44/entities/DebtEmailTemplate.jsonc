{
  "name": "DebtEmailTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Template Name"
    },
    "templateType": {
      "type": "string",
      "title": "Template Type",
      "enum": [
        "night_before",
        "hour_before",
        "manual",
        "custom_automation"
      ],
      "default": "manual"
    },
    "subject": {
      "type": "string",
      "title": "Email Subject (supports {{firstName}}, {{lastName}}, {{appointmentDate}}, {{debtAmount}})"
    },
    "bodyHtml": {
      "type": "string",
      "title": "Email Body (HTML \u2014 supports {{firstName}}, {{lastName}}, {{appointmentDate}}, {{debtAmount}}, {{personalMessageUrl}})",
      "format": "textarea"
    },
    "triggerOffsetHours": {
      "type": "number",
      "title": "Trigger Offset (hours before appointment; negative = before, positive = after)",
      "default": -18
    },
    "triggerTimeOfDay": {
      "type": "string",
      "title": "Trigger Time of Day (HH:MM 24h, e.g. 18:00 \u2014 used for night-before style triggers)"
    },
    "enabled": {
      "type": "boolean",
      "title": "Automation Enabled",
      "default": true
    },
    "attachToContactCard": {
      "type": "boolean",
      "title": "Show as Button on Contact Card",
      "default": false
    },
    "buttonLabel": {
      "type": "string",
      "title": "Contact Card Button Label"
    },
    "buttonColor": {
      "type": "string",
      "title": "Button Color (hex)",
      "default": "#10b981"
    },
    "trackingEnabled": {
      "type": "boolean",
      "title": "Track Opens & Clicks",
      "default": true
    },
    "personalMessageUrl": {
      "type": "string",
      "title": "Personal Message Audio URL (tracks clicks for the contact card badge; supports {{leadId}}, {{firstName}})"
    },
    "includeSignature": {
      "type": "boolean",
      "title": "Include Email Signature",
      "default": true
    },
    "sortOrder": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "updatedBy": {
      "type": "string",
      "title": "Last Updated By (username)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}