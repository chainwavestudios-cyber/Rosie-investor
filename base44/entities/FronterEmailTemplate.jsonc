{
  "name": "FronterEmailTemplate",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "title": "Template Label (shown in dropdown)"
    },
    "subject": {
      "type": "string",
      "title": "Default Subject"
    },
    "body": {
      "type": "string",
      "title": "Email Body (HTML)",
      "format": "textarea"
    },
    "sortOrder": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "isDefault": {
      "type": "boolean",
      "title": "Is a Built-in Default",
      "default": false
    }
  },
  "required": [
    "label"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}