{
  "name": "FronterEmailTemplate",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "title": "Template Label (shown in dropdown)"
    },
    "subject": {
      "type": "string",
      "title": "Default Subject",
      "maxLength": 2000
    },
    "body": {
      "type": "string",
      "title": "Email Body (HTML)",
      "format": "textarea",
      "maxLength": 500000
    },
    "emailProvider": {
      "type": "string",
      "enum": [
        "gmail",
        "smtpfast"
      ],
      "default": "gmail",
      "title": "Email Provider (gmail = the connected Google account, smtpfast = outreach sending)"
    },
    "templateType": {
      "type": "string",
      "title": "Template Type",
      "enum": [
        "manual",
        "follow_up",
        "custom_automation"
      ],
      "default": "manual"
    },
    "triggerOffsetHours": {
      "type": "number",
      "title": "Trigger Offset (hours relative to event; negative = before)",
      "default": 0
    },
    "triggerTimeOfDay": {
      "type": "string",
      "title": "Trigger Time of Day (HH:MM 24h, optional)"
    },
    "enabled": {
      "type": "boolean",
      "title": "Automation Enabled",
      "default": true
    },
    "attachToContactCard": {
      "type": "boolean",
      "title": "Show as Button on Contact Card",
      "default": false
    },
    "buttonLabel": {
      "type": "string",
      "title": "Contact Card Button Label"
    },
    "buttonColor": {
      "type": "string",
      "title": "Button Color (hex)",
      "default": "#10b981"
    },
    "trackingEnabled": {
      "type": "boolean",
      "title": "Track Opens & Clicks",
      "default": true
    },
    "includeSignature": {
      "type": "boolean",
      "title": "Include Email Signature",
      "default": true
    },
    "sortOrder": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    },
    "isDefault": {
      "type": "boolean",
      "title": "Is a Built-in Default",
      "default": false
    },
    "updatedBy": {
      "type": "string",
      "title": "Last Updated By (username)"
    }
  },
  "required": [
    "label"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}