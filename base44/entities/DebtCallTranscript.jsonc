{
  "name": "DebtCallTranscript",
  "type": "object",
  "properties": {
    "leadId": {
      "type": "string",
      "title": "Lead ID"
    },
    "leadName": {
      "type": "string",
      "title": "Lead Name (for display)"
    },
    "leadNumber": {
      "type": "string",
      "title": "Lead Number"
    },
    "agentId": {
      "type": "string",
      "title": "Agent ID (username)"
    },
    "agentName": {
      "type": "string",
      "title": "Agent Name (for display)"
    },
    "transcriptJson": {
      "type": "string",
      "title": "Full Transcript (JSON)",
      "format": "textarea"
    },
    "transcriptLineCount": {
      "type": "number",
      "title": "Transcript Line Count"
    },
    "callMode": {
      "type": "string",
      "title": "Call Mode",
      "enum": [
        "open",
        "close"
      ],
      "default": "open"
    },
    "callType": {
      "type": "string",
      "title": "Call Type (flow structure)",
      "enum": [
        "front_to_back",
        "open_only",
        "cold_call",
        "closer_call"
      ],
      "default": "front_to_back"
    },
    "durationSeconds": {
      "type": "number",
      "title": "Duration (seconds)"
    },
    "intentScore": {
      "type": "number",
      "title": "Intent Score"
    },
    "animalType": {
      "type": "string",
      "title": "Animal Type",
      "enum": [
        "duck",
        "cow",
        "unknown"
      ]
    },
    "intentReport": {
      "type": "string",
      "title": "Intent Report",
      "format": "textarea"
    },
    "intentPlaybookJson": {
      "type": "string",
      "title": "Intent Engine Result (JSON \u2014 full analysis + next-call playbook)",
      "format": "textarea"
    },
    "reportAcknowledgedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Intent Report Acknowledged At (set when the agent confirms and saves the report; empty means it still pops up on open)"
    },
    "followUpReport": {
      "type": "string",
      "title": "Follow-Up Report",
      "format": "textarea"
    },
    "strategies": {
      "type": "string",
      "title": "Potential Strategies",
      "format": "textarea"
    },
    "callAnalysisJson": {
      "type": "string",
      "title": "Call Analysis (JSON \u2014 timeline, manager report, suggestions, follow-up)",
      "format": "textarea"
    },
    "recordingUrl": {
      "type": "string",
      "title": "Call Recording (private file URI \u2014 audio/webm)"
    },
    "callDate": {
      "type": "string",
      "format": "date-time",
      "title": "Call Date"
    }
  },
  "required": [
    "leadId",
    "callDate"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}