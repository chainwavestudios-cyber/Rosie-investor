{
  "name": "DebtCallTranscript",
  "type": "object",
  "properties": {
    "leadId": {
      "type": "string",
      "title": "Lead ID"
    },
    "leadName": {
      "type": "string",
      "title": "Lead Name (for display)"
    },
    "leadNumber": {
      "type": "string",
      "title": "Lead Number"
    },
    "transcriptJson": {
      "type": "string",
      "title": "Full Transcript (JSON)",
      "format": "textarea"
    },
    "transcriptLineCount": {
      "type": "number",
      "title": "Transcript Line Count"
    },
    "callMode": {
      "type": "string",
      "title": "Call Mode",
      "enum": [
        "open",
        "close"
      ],
      "default": "open"
    },
    "durationSeconds": {
      "type": "number",
      "title": "Duration (seconds)"
    },
    "intentScore": {
      "type": "number",
      "title": "Intent Score"
    },
    "animalType": {
      "type": "string",
      "title": "Animal Type",
      "enum": [
        "duck",
        "cow",
        "unknown"
      ]
    },
    "intentReport": {
      "type": "string",
      "title": "Intent Report",
      "format": "textarea"
    },
    "followUpReport": {
      "type": "string",
      "title": "Follow-Up Report",
      "format": "textarea"
    },
    "strategies": {
      "type": "string",
      "title": "Potential Strategies",
      "format": "textarea"
    },
    "callDate": {
      "type": "string",
      "format": "date-time",
      "title": "Call Date"
    }
  },
  "required": [
    "leadId",
    "callDate"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}