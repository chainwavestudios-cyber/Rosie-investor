{
  "name": "SuperAdminConfig",
  "type": "object",
  "properties": {
    "configName": {
      "type": "string",
      "title": "Config Name (singleton key)",
      "default": "default"
    },
    "noticeIdSeq": {
      "type": "number",
      "title": "Notice ID Sequence (last Notice ID number issued \u2014 NFS-99999-999 series)"
    },
    "transferScript": {
      "type": "string",
      "title": "Appointment Transfer Script (assistant portal contact card)",
      "format": "textarea"
    },
    "reminderScript": {
      "type": "string",
      "title": "1-Hour Reminder Script ({{firstname}}, {{Email}} supported)",
      "format": "textarea"
    },
    "rebookScript": {
      "type": "string",
      "title": "Rebook Appointment Script (read on the contact card's Rebook tab \u2014 {{firstname}}, {{Email}}, {{appointment}} supported)",
      "format": "textarea"
    },
    "assistantScriptTabsJson": {
      "type": "string",
      "title": "Assistant Script Tabs (JSON array of {label, script} \u2014 extra tabs the super admin adds to every calendar contact card)",
      "format": "textarea"
    },
    "mergeScript": {
      "type": "string",
      "title": "Merge & Transfer Script (contact card merge popup)",
      "format": "textarea"
    },
    "welcomeMessage": {
      "type": "string",
      "title": "Welcome Message (shown in the assistant portal contact card)",
      "format": "textarea"
    },
    "welcomeMessageUrl": {
      "type": "string",
      "title": "Welcome Message Link (where \u201clisten to my personal welcome message\u201d points in the credentials email \u2014 its clicks are tracked on the contact card and the Prospect Tracking tab)"
    },
    "transferPhoneNumber": {
      "type": "string",
      "title": "Merge & Transfer Number 1 (E.164)"
    },
    "transferPhoneNumber2": {
      "type": "string",
      "title": "Merge & Transfer Number 2 (E.164)"
    },
    "transferLabel": {
      "type": "string",
      "title": "Merge & Transfer Label 1 (display only)"
    },
    "transferLabel2": {
      "type": "string",
      "title": "Merge & Transfer Label 2 (display only)"
    },
    "chrisOfficePhone": {
      "type": "string",
      "title": "Fast-Dial \u2014 Office Number (E.164)"
    },
    "chrisOfficeLabel": {
      "type": "string",
      "title": "Fast-Dial \u2014 Office Tag (button text shown to every user)",
      "default": "Chris \u00b7 Office"
    },
    "chrisCellPhone": {
      "type": "string",
      "title": "Fast-Dial \u2014 Mobile Number (E.164)"
    },
    "chrisMobileLabel": {
      "type": "string",
      "title": "Fast-Dial \u2014 Mobile Tag (button text shown to every user)",
      "default": "Chris \u00b7 Mobile"
    },
    "optInControlsHidden": {
      "type": "boolean",
      "title": "Hide The Opt-In Action Buttons Everywhere (super admin toggle \u2014 Spread over days, Opt In Every Lead, Subscribe All To Email List)",
      "default": false
    },
    "workspacePlan": {
      "type": "string",
      "title": "Base44 Plan (snapshot)"
    },
    "messageCreditsLeft": {
      "type": "number",
      "title": "Message Credits Left (snapshot)"
    },
    "messageCreditsTotal": {
      "type": "number",
      "title": "Message Credits Total (snapshot)"
    },
    "integrationCreditsUsed": {
      "type": "number",
      "title": "Integration Credits Used (snapshot)"
    },
    "integrationCreditsTotal": {
      "type": "number",
      "title": "Integration Credits Total (snapshot)"
    },
    "creditsResetDate": {
      "type": "string",
      "title": "Credits Reset Date (YYYY-MM-DD)"
    },
    "snapshotAt": {
      "type": "string",
      "format": "date-time",
      "title": "Snapshot Taken At"
    },
    "updatedBy": {
      "type": "string",
      "title": "Last Updated By (username)"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Last Updated At"
    }
  },
  "required": [
    "configName"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}