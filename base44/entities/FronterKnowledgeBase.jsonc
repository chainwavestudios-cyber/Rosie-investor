    },
    "answer": {
      "type": "string",
      "title": "Answer",
      "format": "textarea"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "tags": {
      "type": "string",
      "title": "Tags"
    },
    "sortOrder": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "question",
    "answer"
  ],
  "rls": {
