{
  "name": "FronterKnowledgeBase",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "title": "Question (customer's exact phrase)"
    },
    "answer": {
      "type": "string",
      "title": "Answer (read verbatim to customer)",
      "format": "textarea"
    },
    "alternativeQuestions": {
      "type": "string",
      "title": "Alternative Questions (JSON array \u2014 other ways the customer might phrase it, including statement-form)",
      "format": "textarea"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "tags": {
      "type": "string",
      "title": "Tags"
    },
    "sourceType": {
      "type": "string",
      "title": "Source Type (manual, document, mp3_call)",
      "enum": [
        "manual",
        "document",
        "mp3_call"
      ],
      "default": "manual"
    },
    "sourceFileName": {
      "type": "string",
      "title": "Source File Name (for document/mp3 uploads)"
    },
    "sortOrder": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "question",
    "answer"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}