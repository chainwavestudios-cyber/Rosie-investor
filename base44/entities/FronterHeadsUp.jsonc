{
  "name": "FronterHeadsUp",
  "type": "object",
  "properties": {
    "fronterUsername": {
      "type": "string",
      "title": "Fronter Username"
    },
    "leadId": {
      "type": "string",
      "title": "Lead ID"
    },
    "leadName": {
      "type": "string",
      "title": "Lead Name"
    },
    "leadPhone": {
      "type": "string",
      "title": "Lead Phone"
    },
    "leadEmail": {
      "type": "string",
      "title": "Lead Email (for appointment reminders)"
    },
    "conferenceName": {
      "type": "string",
      "title": "Conference Name (for listen/barge)"
    },
    "customerCallSid": {
      "type": "string",
      "title": "Customer Call SID (for redirect from hold queue)"
    },
    "routeType": {
      "type": "string",
      "title": "Handoff source e.g. ai_agent"
    },
    "routeState": {
      "type": "string",
      "title": "Advisor routing state"
    },
    "queueStartedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Queue start"
    },
    "debtAmount": {
      "type": "number",
      "title": "Confirmed debt for transfer popup"
    },
    "advisorAttempt": {
      "type": "number",
      "title": "Advisor attempt number"
    },
    "lineKey": {
      "type": "string",
      "title": "Twilio Line Key (for listen)"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "title": "Created At"
    }
  },
  "required": [
    "fronterUsername",
    "leadId"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}