{
  "name": "DebtMarketingSend",
  "type": "object",
  "properties": {
    "campaignId": {
      "type": "string",
      "title": "Campaign ID"
    },
    "campaignName": {
      "type": "string",
      "title": "Campaign Name (for display)"
    },
    "vaultEntryId": {
      "type": "string",
      "title": "Lead Vault Entry ID"
    },
    "leadName": {
      "type": "string",
      "title": "Lead Name (for display)"
    },
    "email": {
      "type": "string",
      "title": "Recipient Email"
    },
    "state": {
      "type": "string",
      "title": "Recipient State"
    },
    "kind": {
      "type": "string",
      "title": "Send Kind (intro = the campaign's own email, intro2 = the Introduction 2 follow-up)",
      "enum": [
        "intro",
        "intro2"
      ],
      "default": "intro"
    },
    "templateId": {
      "type": "string",
      "title": "Saved Email ID Used For This Send (blank = the campaign's email)"
    },
    "templateName": {
      "type": "string",
      "title": "Saved Email Name (for display)"
    },
    "sendAt": {
      "type": "string",
      "format": "date-time",
      "title": "Scheduled Send Time"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "pending"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "title": "Sent At"
    },
    "error": {
      "type": "string",
      "title": "Error / Skip Reason",
      "format": "textarea"
    },
    "mailjetMessageId": {
      "type": "string",
      "title": "Mailjet Message ID"
    },
    "linkHostsJson": {
      "type": "string",
      "title": "Link Hosts In This Email (JSON array \u2014 the only links the tracker will forward to)",
      "format": "textarea"
    },
    "openCount": {
      "type": "number",
      "title": "Times Opened",
      "default": 0
    },
    "firstOpenedAt": {
      "type": "string",
      "format": "date-time",
      "title": "First Opened At"
    },
    "lastOpenedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Last Opened At"
    },
    "clickedUrlsJson": {
      "type": "string",
      "title": "Links Clicked (JSON array of {url, at})",
      "format": "textarea"
    },
    "firstClickedAt": {
      "type": "string",
      "format": "date-time",
      "title": "First Link Clicked At"
    },
    "lastClickedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Last Link Clicked At"
    },
    "welcomeViewedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Welcome Message Opened At (the email's welcome / personal message link)"
    },
    "intro2QueuedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Introduction 2 Queued At (welcome watched + 2/3 links clicked)"
    },
    "chainReason": {
      "type": "string",
      "title": "Why The Follow-Up Fired (e.g. welcome watched + trustpilot.com, bbb.org)"
    },
    "intro2SentAt": {
      "type": "string",
      "format": "date-time",
      "title": "Introduction 2 Sent At"
    },
    "callEventId": {
      "type": "string",
      "title": "Call Calendar Event ID (Google Calendar)"
    },
    "callEventAt": {
      "type": "string",
      "format": "date-time",
      "title": "Scheduled Call Time"
    },
    "callMeetingId": {
      "type": "string",
      "title": "Call Reminder Record ID (FronterMeeting shown in the coach popup)"
    }
  },
  "required": [
    "campaignId",
    "sendAt"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}