{
  "name": "AIAgentConfig",
  "type": "object",
  "properties": {
    "configName": {
      "type": "string",
      "title": "Config Name (singleton key)",
      "default": "default"
    },
    "isActive": {
      "type": "boolean",
      "title": "Agent Active (live on the selected Twilio line)",
      "default": false
    },
    "twilioLineKey": {
      "type": "string",
      "title": "Twilio Line Key (the line the AI agent answers)"
    },
    "transferPhoneNumber": {
      "type": "string",
      "title": "Transfer Target Phone Number \u2014 Primary (E.164)",
      "default": "+16193530919"
    },
    "transferPhoneNumber2": {
      "type": "string",
      "title": "Transfer Target Phone Number \u2014 Secondary (E.164)",
      "default": "+12162586934"
    },
    "queueTimeoutSeconds": {
      "type": "number",
      "title": "Queue Wait Timeout (seconds before fallback)",
      "default": 90
    },
    "sttEngine": {
      "type": "string",
      "title": "STT Engine",
      "enum": [
        "deepgram-nova-2",
        "deepgram-nova-3",
        "flux"
      ],
      "default": "deepgram-nova-2"
    },
    "ttsEngine": {
      "type": "string",
      "title": "TTS Engine",
      "enum": [
        "deepgram-aura",
        "flux",
        "elevenlabs"
      ],
      "default": "deepgram-aura"
    },
    "ttsVoiceModel": {
      "type": "string",
      "title": "TTS Voice Model / Voice ID (legacy fallback \u2014 use elevenLabsVoiceId or deepgramTtsVoice)",
      "default": "aura-2-thalia-en"
    },
    "elevenLabsVoiceId": {
      "type": "string",
      "title": "ElevenLabs Voice ID (separate from Deepgram voice)"
    },
    "deepgramTtsVoice": {
      "type": "string",
      "title": "Deepgram TTS Voice ID (Aura-2 or Flux \u2014 e.g. aura-2-thalia-en or flux-alexis-en)",
      "default": "aura-2-thalia-en"
    },
    "ttsSynthesisModel": {
      "type": "string",
      "title": "ElevenLabs Synthesis Model",
      "enum": [
        "eleven_v3",
        "eleven_multilingual_v2",
        "eleven_turbo_v2_5",
        "eleven_flash_v2_5"
      ],
      "default": "eleven_flash_v2_5"
    },
    "llmModel": {
      "type": "string",
      "title": "LLM selection (exact request ID shown in runtime cross-check)",
      "enum": [
        "automatic",
        "gemini-2.5-flash-lite",
        "gemini-2.5-flash",
        "gemini_3_flash",
        "gemini_3_8_flash",
        "gpt_6_luna",
        "claude-sonnet-5",
        "claude_opus_5_5",
        "gpt_6_sol",
        "gpt_6_astra",
        "claude_fable_5_1",
        "glm_5_2",
        "gemini-3-flash",
        "gpt-5-mini",
        "claude-opus-5",
        "claude-sonnet-4-6",
        "gpt-5-4",
        "gemini-3-1-pro"
      ],
      "default": "automatic"
    },
    "kbPrimary": {
      "type": "string",
      "title": "Primary Knowledge Base",
      "enum": [
        "fronter",
        "debtcallcoach"
      ],
      "default": "fronter"
    },
    "kbSecondary": {
      "type": "string",
      "title": "Secondary Knowledge Base",
      "enum": [
        "fronter",
        "debtcallcoach",
        "none"
      ],
      "default": "debtcallcoach"
    },
    "inboundGreetingAudioUrl": {
      "type": "string",
      "title": "Inbound Greeting Audio URL (legacy single-file greeting \u2014 superseded by the dynamic clip pipeline; leave empty to use the pipeline)"
    },
    "greeting": {
      "type": "string",
      "title": "Opening Greeting (spoken aloud when the prospect answers \u2014 NOT the system prompt)",
      "format": "textarea",
      "default": "Hi, may I speak with {{first_name}} please?"
    },
    "systemPrompt": {
      "type": "string",
      "title": "System Prompt (full agent instructions \u2014 never read aloud)",
      "format": "textarea"
    },
    "inboundAgentName": {
      "type": "string",
      "title": "Inbound AI Agent Name (the persona that greets inbound callers after the intro clips)",
      "default": "Adam"
    },
    "inboundSystemPrompt": {
      "type": "string",
      "title": "Inbound Adam System Prompt (used for inbound calls \u2014 collects debt info then transfers to fronter queue)",
      "format": "textarea",
      "default": "You are Adam, a friendly, sharp, concise AI assistant coded by Christopher for Debt Advisors of America. Keep all responses under 2 sentences. The caller just listened to Christopher's intro and said 'Let's get debt free'. Your goal: collect and populate the lead's approximate unsecured debt amount (total_debt), identify debt types (debt_type), and determine the hardship reason (hardship_reason). Once you have all three, say the word TRANSFER to place the caller in the fronter transfer queue. Be warm and conversational. Never exceed two sentences per response."
    },
    "inboundKeywordTriggers": {
      "type": "string",
      "title": "Inbound Keyword Triggers (comma-separated phrases that skip the greeting and hand off to Adam early \u2014 e.g. 'let's get debt free, get debt free, let's do it')",
      "default": "let's get debt free, get debt free, let's do it"
    },
    "scriptFlow": {
      "type": "string",
      "title": "Script Flow (call execution phases)",
      "format": "textarea"
    },
    "dynamicRebuttals": {
      "type": "string",
      "title": "Dynamic Rebuttals & Objection Handling",
      "format": "textarea"
    },
    "qaTuning": {
      "type": "string",
      "title": "Q&A Fine-Tuning Notes",
      "format": "textarea"
    },
    "callbackBookingEnabled": {
      "type": "boolean",
      "title": "Auto-Callback Booking on Transfer Failure",
      "default": true
    },
    "preTransferEmailEnabled": {
      "type": "boolean",
      "title": "Send Pre-Transfer Credential Email",
      "default": true
    },
    "updatedBy": {
      "type": "string",
      "title": "Last Updated By (username)"
    }
  },
  "required": [
    "configName"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}