{
  "name": "AIAgentConfig",
  "type": "object",
  "properties": {
    "configName": {
      "type": "string",
      "title": "Config Name (singleton key)",
      "default": "default"
    },
    "isActive": {
      "type": "boolean",
      "title": "Agent Active (live on the selected Twilio line)",
      "default": false
    },
    "twilioLineKey": {
      "type": "string",
      "title": "Twilio Line Key (the line the AI agent answers)"
    },
    "transferPhoneNumber": {
      "type": "string",
      "title": "Transfer Target Phone Number \u2014 Primary (E.164)",
      "default": "+16193530919"
    },
    "transferPhoneNumber2": {
      "type": "string",
      "title": "Transfer Target Phone Number \u2014 Secondary (E.164)",
      "default": "+12162586934"
    },
    "queueTimeoutSeconds": {
      "type": "number",
      "title": "Queue Wait Timeout (seconds before fallback)",
      "default": 90
    },
    "sttEngine": {
      "type": "string",
      "title": "STT Engine",
      "enum": [
        "deepgram-nova-2",
        "deepgram-nova-3"
      ],
      "default": "deepgram-nova-2"
    },
    "ttsEngine": {
      "type": "string",
      "title": "TTS Engine",
      "enum": [
        "deepgram-aura",
        "elevenlabs"
      ],
      "default": "deepgram-aura"
    },
    "ttsVoiceModel": {
      "type": "string",
      "title": "TTS Voice Model / Voice ID",
      "default": "aura-2-thalia-en"
    },
    "llmModel": {
      "type": "string",
      "title": "LLM Model (gemini-3-flash = fastest for real-time voice)",
      "enum": [
        "gemini-3-flash",
        "gpt-5-mini",
        "claude-sonnet-5",
        "claude-opus-5",
        "claude-sonnet-4-6",
        "gpt-5-4",
        "gemini-3-1-pro"
      ],
      "default": "gemini-3-flash"
    },
    "kbPrimary": {
      "type": "string",
      "title": "Primary Knowledge Base",
      "enum": [
        "fronter",
        "debtcallcoach"
      ],
      "default": "fronter"
    },
    "kbSecondary": {
      "type": "string",
      "title": "Secondary Knowledge Base",
      "enum": [
        "fronter",
        "debtcallcoach",
        "none"
      ],
      "default": "debtcallcoach"
    },
    "greeting": {
      "type": "string",
      "title": "Opening Greeting (spoken aloud when the prospect answers \u2014 NOT the system prompt)",
      "format": "textarea",
      "default": "Hi, may I speak with {{first_name}} please?"
    },
    "systemPrompt": {
      "type": "string",
      "title": "System Prompt (full agent instructions \u2014 never read aloud)",
      "format": "textarea"
    },
    "scriptFlow": {
      "type": "string",
      "title": "Script Flow (call execution phases)",
      "format": "textarea"
    },
    "dynamicRebuttals": {
      "type": "string",
      "title": "Dynamic Rebuttals & Objection Handling",
      "format": "textarea"
    },
    "qaTuning": {
      "type": "string",
      "title": "Q&A Fine-Tuning Notes",
      "format": "textarea"
    },
    "callbackBookingEnabled": {
      "type": "boolean",
      "title": "Auto-Callback Booking on Transfer Failure",
      "default": true
    },
    "preTransferEmailEnabled": {
      "type": "boolean",
      "title": "Send Pre-Transfer Credential Email",
      "default": true
    },
    "updatedBy": {
      "type": "string",
      "title": "Last Updated By (username)"
    }
  },
  "required": [
    "configName"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}