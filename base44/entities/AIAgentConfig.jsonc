{
  "name": "AIAgentConfig",
  "type": "object",
  "properties": {
    "configName": {
      "type": "string",
      "title": "Config Name (singleton key)",
      "default": "default"
    },
    "isActive": {
      "type": "boolean",
      "title": "Agent Active (live on the selected Twilio line)",
      "default": false
    },
    "twilioLineKey": {
      "type": "string",
      "title": "Twilio Line Key (the line the AI agent answers)"
    },
    "transferPhoneNumber": {
      "type": "string",
      "title": "Transfer Target Phone Number \u2014 Primary (E.164)",
      "default": "+16193530919"
    },
    "transferPhoneNumber2": {
      "type": "string",
      "title": "Transfer Target Phone Number \u2014 Secondary (E.164)",
      "default": "+12162586934"
    },
    "queueTimeoutSeconds": {
      "type": "number",
      "title": "Queue Wait Timeout (seconds before fallback)",
      "default": 90
    },
    "sttEngine": {
      "type": "string",
      "title": "STT Engine",
      "enum": [
        "deepgram-nova-2",
        "deepgram-nova-3",
        "flux"
      ],
      "default": "deepgram-nova-2"
    },
    "ttsEngine": {
      "type": "string",
      "title": "TTS Engine",
      "enum": [
        "deepgram-aura",
        "flux",
        "elevenlabs",
        "cartesia"
      ],
      "default": "deepgram-aura"
    },
    "ttsVoiceModel": {
      "type": "string",
      "title": "TTS Voice Model / Voice ID (legacy fallback \u2014 use elevenLabsVoiceId, cartesiaVoiceId or deepgramTtsVoice)",
      "default": "aura-2-thalia-en"
    },
    "elevenLabsVoiceId": {
      "type": "string",
      "title": "ElevenLabs Voice ID (separate from Deepgram voice)"
    },
    "cartesiaVoiceId": {
      "type": "string",
      "title": "Cartesia Voice ID (Sonic voice from your Cartesia voice library \u2014 the bridge needs CARTESIA_API_KEY)",
      "default": "7b3c5c22-9561-425b-8e7a-63dbf1262e35"
    },
    "inboundIntroVoiceId": {
      "type": "string",
      "title": "Inbound Intro Voice ID (ElevenLabs \u2014 speaks the name greeting and regional line before the agent connects; empty falls back to the agent voice)"
    },
    "deepgramTtsVoice": {
      "type": "string",
      "title": "Deepgram TTS Voice ID (Aura-2 or Flux \u2014 e.g. aura-2-thalia-en or flux-alexis-en)",
      "default": "aura-2-thalia-en"
    },
    "ttsSynthesisModel": {
      "type": "string",
      "title": "ElevenLabs Synthesis Model",
      "enum": [
        "eleven_v3",
        "eleven_multilingual_v2",
        "eleven_turbo_v2_5",
        "eleven_flash_v2_5"
      ],
      "default": "eleven_flash_v2_5"
    },
    "llmModel": {
      "type": "string",
      "title": "LLM selection (exact request ID shown in runtime cross-check)",
      "enum": [
        "automatic",
        "gemini-2.5-flash-lite",
        "gemini-2.5-flash",
        "gemini_3_flash",
        "gemini_3_8_flash",
        "gpt_6_luna",
        "claude-sonnet-5",
        "claude_opus_5_5",
        "gpt_6_sol",
        "gpt_6_astra",
        "claude_fable_5_1",
        "glm_5_2",
        "gemini-3-flash",
        "gpt-5-mini",
        "claude-opus-5",
        "claude-sonnet-4-6",
        "gpt-5-4",
        "gemini-3-1-pro"
      ],
      "default": "automatic"
    },
    "kbPrimary": {
      "type": "string",
      "title": "Primary Knowledge Base",
      "enum": [
        "fronter",
        "debtcallcoach"
      ],
      "default": "fronter"
    },
    "kbSecondary": {
      "type": "string",
      "title": "Secondary Knowledge Base",
      "enum": [
        "fronter",
        "debtcallcoach",
        "none"
      ],
      "default": "debtcallcoach"
    },
    "inboundGreetingAudioUrl": {
      "type": "string",
      "title": "Inbound Greeting Audio URL (legacy single-file greeting \u2014 superseded by the dynamic clip pipeline; leave empty to use the pipeline)"
    },
    "greeting": {
      "type": "string",
      "title": "Opening Greeting \u2014 Outgoing (spoken aloud when the prospect answers \u2014 NOT the system prompt)",
      "format": "textarea",
      "default": "Hi, may I speak with {{first_name}} please?"
    },
    "systemPrompt": {
      "type": "string",
      "title": "System Prompt \u2014 Outgoing (full agent instructions for outbound dials \u2014 never read aloud)",
      "format": "textarea"
    },
    "inboundAgentName": {
      "type": "string",
      "title": "Inbound AI Agent Name (the persona that greets inbound callers after the intro clips)",
      "default": "Sarah"
    },
    "inboundOpener": {
      "type": "string",
      "title": "Inbound Opening Line (the first thing the agent says when it takes over an inbound call \u2014 use {{first_name}} and {{state}} for personalization)",
      "format": "textarea",
      "default": "Quick question for you\u2014we recently sent a notice to your address regarding active credit flags across Experian, TransUnion, and Equifax in {{state}}. It shows you're carrying around $20,000 in high-interest credit card debt, and that you qualify for the state rate-drop update. Did you happen to receive that notice in the mail yet, or are you still paying those high rates?"
    },
    "inboundSystemPrompt": {
      "type": "string",
      "title": "Inbound System Prompt (used for inbound calls only \u2014 pivots, debt confirmation, then transfer into the live transfer queue)",
      "format": "textarea",
      "default": "You are {{agent_name}} \u2014 the female voice agent on the Debt Verification Desk for Debt Advisors of America. You are natural, professional, warm, and authoritative. Keep every response to one or two sentences. Do not use formatting, emojis, or special characters."
    },
    "inboundScriptFlow": {
      "type": "string",
      "title": "Inbound Script Flow (call execution phases for incoming calls only \u2014 separate from the outgoing Script Flow)",
      "format": "textarea"
    },
    "inboundKeywordTriggers": {
      "type": "string",
      "title": "Inbound Keyword Triggers (comma-separated phrases that skip the greeting and hand off to the agent early \u2014 e.g. 'let's get debt free, get debt free, let's do it')",
      "default": "let's get debt free, get debt free, let's do it"
    },
    "scriptFlow": {
      "type": "string",
      "title": "Script Flow \u2014 Outgoing (call execution phases for outbound dials)",
      "format": "textarea"
    },
    "dynamicRebuttals": {
      "type": "string",
      "title": "Dynamic Rebuttals & Objection Handling \u2014 Outgoing (outbound calls only)",
      "format": "textarea"
    },
    "qaTuning": {
      "type": "string",
      "title": "Q&A Fine-Tuning Notes \u2014 Outgoing (outbound calls only)",
      "format": "textarea"
    },
    "callbackBookingEnabled": {
      "type": "boolean",
      "title": "Auto-Callback Booking on Transfer Failure",
      "default": true
    },
    "preTransferEmailEnabled": {
      "type": "boolean",
      "title": "Send Pre-Transfer Credential Email",
      "default": true
    },
    "updatedBy": {
      "type": "string",
      "title": "Last Updated By (username)"
    }
  },
  "required": [
    "configName"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}