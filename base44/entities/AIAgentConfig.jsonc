{
  "name": "AIAgentConfig",
  "type": "object",
  "properties": {
    "configName": {
      "type": "string",
      "title": "Config Name (singleton key)",
      "default": "default"
    },
    "isActive": {
      "type": "boolean",
      "title": "Agent Active (live on the selected Twilio line)",
      "default": false
    },
    "twilioLineKey": {
      "type": "string",
      "title": "Twilio Line Key (the line the AI agent answers)"
    },
    "transferPhoneNumber": {
      "type": "string",
      "title": "Transfer Target Phone Number \u2014 Primary (E.164)",
      "default": "+16193530919"
    },
    "transferPhoneNumber2": {
      "type": "string",
      "title": "Transfer Target Phone Number \u2014 Secondary (E.164)",
      "default": "+12162586934"
    },
    "queueTimeoutSeconds": {
      "type": "number",
      "title": "Queue Wait Timeout (seconds before fallback)",
      "default": 90
    },
    "sttEngine": {
      "type": "string",
      "title": "STT Engine",
      "enum": [
        "deepgram-nova-2",
        "deepgram-nova-3",
        "flux"
      ],
      "default": "deepgram-nova-2"
    },
    "ttsEngine": {
      "type": "string",
      "title": "TTS Engine",
      "enum": [
        "deepgram-aura",
        "flux",
        "elevenlabs"
      ],
      "default": "deepgram-aura"
    },
    "ttsVoiceModel": {
      "type": "string",
      "title": "TTS Voice Model / Voice ID (legacy fallback \u2014 use elevenLabsVoiceId or deepgramTtsVoice)",
      "default": "aura-2-thalia-en"
    },
    "elevenLabsVoiceId": {
      "type": "string",
      "title": "ElevenLabs Voice ID (separate from Deepgram voice)"
    },
    "deepgramTtsVoice": {
      "type": "string",
      "title": "Deepgram TTS Voice ID (Aura-2 or Flux \u2014 e.g. aura-2-thalia-en or flux-alexis-en)",
      "default": "aura-2-thalia-en"
    },
    "ttsSynthesisModel": {
      "type": "string",
      "title": "ElevenLabs Synthesis Model",
      "enum": [
        "eleven_turbo_v2_5",
        "eleven_flash_v2_5"
      ],
      "default": "eleven_flash_v2_5"
    },
    "llmModel": {
      "type": "string",
      "title": "LLM selection (exact request ID shown in runtime cross-check)",
      "enum": [
        "automatic",
        "gemini_3_8_flash",
        "gpt_6_luna",
        "claude-sonnet-5",
        "claude_opus_5_5",
        "gpt_6_sol",
        "gpt_6_astra",
        "claude_fable_5_1",
        "glm_5_2",
        "gemini-3-flash",
        "gpt-5-mini",
        "claude-opus-5",
        "claude-sonnet-4-6",
        "gpt-5-4",
        "gemini-3-1-pro"
      ],
      "default": "automatic"
    },
    "kbPrimary": {
      "type": "string",
      "title": "Primary Knowledge Base",
      "enum": [
        "fronter",
        "debtcallcoach"
      ],
      "default": "fronter"
    },
    "kbSecondary": {
      "type": "string",
      "title": "Secondary Knowledge Base",
      "enum": [
        "fronter",
        "debtcallcoach",
        "none"
      ],
      "default": "debtcallcoach"
    },
    "greeting": {
      "type": "string",
      "title": "Opening Greeting (spoken aloud when the prospect answers \u2014 NOT the system prompt)",
      "format": "textarea",
      "default": "Hi, may I speak with {{first_name}} please?"
    },
    "systemPrompt": {
      "type": "string",
      "title": "System Prompt (full agent instructions \u2014 never read aloud)",
      "format": "textarea"
    },
    "scriptFlow": {
      "type": "string",
      "title": "Script Flow (call execution phases)",
      "format": "textarea"
    },
    "dynamicRebuttals": {
      "type": "string",
      "title": "Dynamic Rebuttals & Objection Handling",
      "format": "textarea"
    },
    "qaTuning": {
      "type": "string",
      "title": "Q&A Fine-Tuning Notes",
      "format": "textarea"
    },
    "callbackBookingEnabled": {
      "type": "boolean",
      "title": "Auto-Callback Booking on Transfer Failure",
      "default": true
    },
    "preTransferEmailEnabled": {
      "type": "boolean",
      "title": "Send Pre-Transfer Credential Email",
      "default": true
    },
    "updatedBy": {
      "type": "string",
      "title": "Last Updated By (username)"
    }
  },
  "required": [
    "configName"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}