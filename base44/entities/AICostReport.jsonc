{
  "name": "AICostReport",
  "type": "object",
  "properties": {
    "reportDate": {
      "type": "string",
      "title": "Report Date (YYYY-MM-DD, Eastern Time day covered)"
    },
    "windowStart": {
      "type": "string",
      "format": "date-time",
      "title": "Window Start (UTC)"
    },
    "windowEnd": {
      "type": "string",
      "format": "date-time",
      "title": "Window End (UTC)"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Generated At"
    },
    "generatedBy": {
      "type": "string",
      "title": "Generated By (workflow or username)"
    },
    "totalCostUsd": {
      "type": "number",
      "title": "Total Exact AI Cost (USD)",
      "default": 0
    },
    "totalAICalls": {
      "type": "number",
      "title": "Total AI Calls",
      "default": 0
    },
    "anthropicCalls": {
      "type": "number",
      "title": "Calls on the Anthropic Key (exact)",
      "default": 0
    },
    "platformCalls": {
      "type": "number",
      "title": "Calls on Platform Credits (no token usage)",
      "default": 0
    },
    "estimatedPlatformCredits": {
      "type": "number",
      "title": "Estimated Platform Credits",
      "default": 0
    },
    "inputTokens": {
      "type": "number",
      "title": "Total Input Tokens",
      "default": 0
    },
    "outputTokens": {
      "type": "number",
      "title": "Total Output Tokens",
      "default": 0
    },
    "cacheReadTokens": {
      "type": "number",
      "title": "Total Cache Read Tokens",
      "default": 0
    },
    "cacheWriteTokens": {
      "type": "number",
      "title": "Total Cache Write Tokens",
      "default": 0
    },
    "callCount": {
      "type": "number",
      "title": "Calls With AI Activity",
      "default": 0
    },
    "truncated": {
      "type": "boolean",
      "title": "Truncated (some low-cost calls omitted to fit storage)",
      "default": false
    },
    "callsJson": {
      "type": "string",
      "title": "Per-Call Breakdown (JSON array, highest cost first)",
      "format": "textarea"
    },
    "byAgentJson": {
      "type": "string",
      "title": "By Agent (JSON array)",
      "format": "textarea"
    },
    "byTypeJson": {
      "type": "string",
      "title": "By AI Call Type (JSON array)",
      "format": "textarea"
    }
  },
  "required": [
    "reportDate"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}