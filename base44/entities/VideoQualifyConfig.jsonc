{
  "name": "VideoQualifyConfig",
  "type": "object",
  "properties": {
    "configName": {
      "type": "string",
      "title": "Config Name (singleton key)",
      "default": "default"
    },
    "isActive": {
      "type": "boolean",
      "title": "Widget Live",
      "default": true
    },
    "agentDrivenMode": {
      "type": "boolean",
      "title": "Drive The Avatar With Our Own Agent (our LLM + knowledge base decide every line, our voice speaks it \u2014 the embed is ignored)",
      "default": false
    },
    "kbName": {
      "type": "string",
      "title": "Knowledge Base She Answers From (the KnowledgeBase set to search, plus everything in the Fronter knowledge base)",
      "default": "Debt Settlement"
    },
    "agentVoiceId": {
      "type": "string",
      "title": "Her Voice \u2014 ElevenLabs Voice ID (used by the agent-driven avatar)",
      "default": "ogwqBH5bbF03DSbNiRNN"
    },
    "agentName": {
      "type": "string",
      "title": "Agent Name (shown in the widget)",
      "default": "Sarah"
    },
    "assistantId": {
      "type": "string",
      "title": "Vapi Assistant ID (filled by the assistant sync)"
    },
    "firstMessage": {
      "type": "string",
      "title": "First Message ({{name}} and {{state}} are filled per visitor)",
      "format": "textarea",
      "default": "Hey {{name}}! I'm Sarah. I was just reviewing your profile inside the system. I noticed you're navigating some tough credit card balances over in {{state}}, and I wanted to see if we can help you wipe them out. To make sure you qualify for our programmatic relief, do you currently owe more than $5,000 across your accounts?"
    },
    "systemPrompt": {
      "type": "string",
      "title": "System Prompt (Sarah's full qualification instructions)",
      "format": "textarea",
      "default": "You are Sarah, an empathetic, clear, and highly professional financial assistant qualifying leads for a debt relief program. Your tone must be warm and human \u2014 never rigid or legalistic."
    },
    "voiceProvider": {
      "type": "string",
      "title": "Voice Provider (Vapi)",
      "enum": [
        "cartesia",
        "elevenlabs"
      ],
      "default": "cartesia"
    },
    "cartesiaVoiceId": {
      "type": "string",
      "title": "Cartesia Voice ID (Sonic voice from your Cartesia voice library)"
    },
    "elevenLabsVoiceId": {
      "type": "string",
      "title": "ElevenLabs Voice ID",
      "default": "21m00Tcm4TlvDq8ikWAM"
    },
    "llmModel": {
      "type": "string",
      "title": "LLM Model (OpenAI)",
      "default": "gpt-4o"
    },
    "temperature": {
      "type": "number",
      "title": "LLM Temperature",
      "default": 0.6
    },
    "salesLine": {
      "type": "string",
      "title": "Primary Sales Line To Bridge To (E.164)",
      "default": "+16193530919"
    },
    "bridgeWhisper": {
      "type": "string",
      "title": "Rep Whisper Line (spoken to the rep just before the client joins)",
      "default": "Live transfer from Sarah. A qualified client is on the line. Connecting you now."
    },
    "protofaceEmbedId": {
      "type": "string",
      "title": "Protoface Embed ID (the live video avatar conversation \u2014 emb_...; used when the widget is not agent-driven)"
    },
    "protofaceEmbedUrl": {
      "type": "string",
      "title": "Protoface Embed Page URL (only for the plain fallback frame \u2014 embed id above is used first)",
      "format": "textarea"
    },
    "protofaceAvatarId": {
      "type": "string",
      "title": "Protoface Avatar ID (av_... \u2014 the avatar the agent-driven widget brings into the call)"
    },
    "updatedBy": {
      "type": "string",
      "title": "Last Updated By"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Last Updated At"
    }
  },
  "required": [
    "configName"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}