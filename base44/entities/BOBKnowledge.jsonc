      "title": "organization ID"
    },
    "title": {
      "type": "string",
      "title": "title"
    },
    "content": {
      "type": "string",
      "title": "content"
    },
    "category": {
      "type": "string",
      "title": "category"
    },
    "createdBy": {
      "type": "string",
      "title": "createdBy"
    },
    "createdAt": {
      "type": "string",
      "title": "createdAt"
    },
    "encryptedPayload": {
