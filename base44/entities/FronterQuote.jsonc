{
  "name": "FronterQuote",
  "type": "object",
  "properties": {
    "quoteText": {
      "type": "string",
      "title": "Quote Text",
      "format": "textarea"
    },
    "authorName": {
      "type": "string",
      "title": "Author Display Name",
      "default": "Chris - Sr. Debt Advisor"
    },
    "scheduledTime": {
      "type": "string",
      "format": "date-time",
      "title": "Scheduled Broadcast Time"
    },
    "sentAt": {
      "type": "string",
      "format": "date-time",
      "title": "Sent At (null = pending)"
    },
    "sourceType": {
      "type": "string",
      "title": "Source Type",
      "enum": [
        "ai_scheduled",
        "admin_custom"
      ],
      "default": "admin_custom"
    },
    "isActive": {
      "type": "boolean",
      "title": "Active",
      "default": true
    }
  },
  "required": [
    "quoteText",
    "scheduledTime"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}