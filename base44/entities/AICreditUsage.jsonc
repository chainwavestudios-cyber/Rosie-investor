{
  "name": "AICreditUsage",
  "type": "object",
  "properties": {
    "agentUsername": {
      "type": "string",
      "title": "Agent / Employee Username"
    },
    "leadId": {
      "type": "string",
      "title": "Lead / Client ID"
    },
    "leadName": {
      "type": "string",
      "title": "Lead Name (for display)"
    },
    "leadNumber": {
      "type": "string",
      "title": "Lead Number"
    },
    "transcriptId": {
      "type": "string",
      "title": "Call Transcript ID"
    },
    "callId": {
      "type": "string",
      "title": "AI Call ID (links the app's log row to its exact-usage row)"
    },
    "callType": {
      "type": "string",
      "title": "AI Call Type (qa, coach, intent, profile, contact, handoff, hardship, cosigners, credit, budget, debt_extract, intent_final, full_report, call_analysis, extract_facts, compliance, cold_call_name, etc.)"
    },
    "provider": {
      "type": "string",
      "title": "Provider (set to 'anthropic' by the exact-usage tracker; empty = platform InvokeLLM credits)",
      "enum": [
        "anthropic",
        "base44"
      ]
    },
    "model": {
      "type": "string",
      "title": "Model Used",
      "default": "automatic"
    },
    "estimatedCredits": {
      "type": "number",
      "title": "Estimated Integration Credits",
      "default": 1
    },
    "costUsd": {
      "type": "number",
      "title": "Exact Cost (USD, computed from token counts)",
      "default": 0
    },
    "inputTokens": {
      "type": "number",
      "title": "Input Tokens (from Anthropic usage)",
      "default": 0
    },
    "outputTokens": {
      "type": "number",
      "title": "Output Tokens (from Anthropic usage)",
      "default": 0
    },
    "cacheReadTokens": {
      "type": "number",
      "title": "Cache Read Tokens (90% discount applied)",
      "default": 0
    },
    "cacheWriteTokens": {
      "type": "number",
      "title": "Cache Write Tokens (prompt caching)",
      "default": 0
    },
    "calledAt": {
      "type": "string",
      "format": "date-time",
      "title": "Called At"
    }
  },
  "required": [
    "callType"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}