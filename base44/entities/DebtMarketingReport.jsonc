{
  "name": "DebtMarketingReport",
  "type": "object",
  "properties": {
    "reportDate": {
      "type": "string",
      "title": "Report Date (YYYY-MM-DD, Eastern Time day covered)"
    },
    "windowStart": {
      "type": "string",
      "format": "date-time",
      "title": "Window Start (UTC)"
    },
    "windowEnd": {
      "type": "string",
      "format": "date-time",
      "title": "Window End (UTC)"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Generated At"
    },
    "generatedBy": {
      "type": "string",
      "title": "Generated By (nightly run or username)"
    },
    "totalEmailsSent": {
      "type": "number",
      "title": "Emails Sent",
      "default": 0
    },
    "totalOpened": {
      "type": "number",
      "title": "Emails Opened",
      "default": 0
    },
    "totalWelcomeViewed": {
      "type": "number",
      "title": "Welcome Messages Watched",
      "default": 0
    },
    "totalLinksClicked": {
      "type": "number",
      "title": "Links Clicked",
      "default": 0
    },
    "totalIntro2Sent": {
      "type": "number",
      "title": "Introduction 2 Sent",
      "default": 0
    },
    "totalCallsScheduled": {
      "type": "number",
      "title": "Call Events Scheduled",
      "default": 0
    },
    "peopleCount": {
      "type": "number",
      "title": "People With Activity",
      "default": 0
    },
    "rowsJson": {
      "type": "string",
      "title": "Per-Person Detail (JSON array)",
      "format": "textarea"
    }
  },
  "required": [
    "reportDate"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}