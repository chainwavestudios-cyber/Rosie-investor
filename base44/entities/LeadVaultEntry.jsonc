{
  "name": "LeadVaultEntry",
  "type": "object",
  "properties": {
    "batchLabel": {
      "type": "string",
      "title": "Batch Label (upload name or source)"
    },
    "firstName": {
      "type": "string",
      "title": "First Name"
    },
    "lastName": {
      "type": "string",
      "title": "Last Name"
    },
    "companyName": {
      "type": "string",
      "title": "Company Name"
    },
    "phone": {
      "type": "string",
      "title": "Primary Phone (raw input or Tracerfy-appended mobile/landline)"
    },
    "phone2": {
      "type": "string",
      "title": "Secondary Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "city": {
      "type": "string",
      "title": "City"
    },
    "state": {
      "type": "string",
      "title": "State"
    },
    "zipCode": {
      "type": "string",
      "title": "Zip Code"
    },
    "debtAmount": {
      "type": "number",
      "title": "Debt Amount ($)"
    },
    "estimatedDebt": {
      "type": "number",
      "title": "Estimated Debt ($)",
      "default": 20000
    },
    "notes": {
      "type": "string",
      "title": "Notes",
      "format": "textarea"
    },
    "pipelineStatus": {
      "type": "string",
      "title": "Pipeline Status",
      "enum": [
        "raw",
        "tracing",
        "traced",
        "validating",
        "ready",
        "dialed",
        "transferred",
        "dead"
      ],
      "default": "raw"
    },
    "tracerfyStatus": {
      "type": "string",
      "title": "Tracerfy Phone-Append Status",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed",
        "skipped"
      ],
      "default": "pending"
    },
    "tracerfyBatchId": {
      "type": "string",
      "title": "Tracerfy Batch ID"
    },
    "tracerfyHit": {
      "type": "boolean",
      "title": "Tracerfy Hit (match found)"
    },
    "tracerfyCreditsUsed": {
      "type": "number",
      "title": "Tracerfy Credits Used"
    },
    "tracerfyProcessedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Tracerfy Processed At"
    },
    "rawPhone": {
      "type": "string",
      "title": "Raw Phone (original input before Tracerfy append)"
    },
    "mobilePhone": {
      "type": "string",
      "title": "Mobile Phone (Tracerfy-appended)"
    },
    "landlinePhone": {
      "type": "string",
      "title": "Landline Phone (Tracerfy-appended)"
    },
    "carrierName": {
      "type": "string",
      "title": "Carrier Name (Tracerfy)"
    },
    "lineType": {
      "type": "string",
      "title": "Line Type",
      "enum": [
        "mobile",
        "landline",
        "voip",
        "invalid",
        "unverified"
      ],
      "default": "unverified"
    },
    "validationStatus": {
      "type": "string",
      "title": "Twilio/Omkar Validation Status",
      "enum": [
        "pending",
        "validated",
        "failed"
      ],
      "default": "pending"
    },
    "phoneValid": {
      "type": "boolean",
      "title": "Primary Phone Valid"
    },
    "phoneLineType": {
      "type": "string",
      "title": "Primary Phone Line Type (Twilio/Omkar verified)",
      "enum": [
        "mobile",
        "landline",
        "voip",
        "unknown"
      ],
      "default": "unknown"
    },
    "phoneCarrier": {
      "type": "string",
      "title": "Primary Phone Carrier"
    },
    "phoneE164": {
      "type": "string",
      "title": "Primary Phone E.164 Format"
    },
    "phone2Valid": {
      "type": "boolean",
      "title": "Secondary Phone Valid"
    },
    "phone2LineType": {
      "type": "string",
      "title": "Secondary Phone Line Type",
      "enum": [
        "mobile",
        "landline",
        "voip",
        "unknown"
      ],
      "default": "unknown"
    },
    "phone2Carrier": {
      "type": "string",
      "title": "Secondary Phone Carrier"
    },
    "phone2E164": {
      "type": "string",
      "title": "Secondary Phone E.164 Format"
    },
    "validatedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Validated At"
    },
    "destination": {
      "type": "string",
      "title": "Distribution Destination",
      "enum": [
        "none",
        "fronter",
        "ai_dialer"
      ],
      "default": "none"
    },
    "assignedTo": {
      "type": "string",
      "title": "Assigned To (fronter username)"
    },
    "assignedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Assigned At"
    },
    "distributedAt": {
      "type": "string",
      "format": "date-time",
      "title": "Distributed At"
    },
    "distributedBy": {
      "type": "string",
      "title": "Distributed By (admin username)"
    },
    "fronterLeadId": {
      "type": "string",
      "title": "Fronter Lead ID (created on distribution)"
    },
    "uploadedBy": {
      "type": "string",
      "title": "Uploaded By (admin username)"
    }
  },
  "required": [
    "firstName",
    "lastName"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}