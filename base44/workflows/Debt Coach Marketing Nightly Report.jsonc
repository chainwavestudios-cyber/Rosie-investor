{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "55 23 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Debt Coach Marketing Nightly Report",
  "description": "Runs the Debt Call Coach marketing engagement report at the end of each night",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "debt_coach_marketing_nightly_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_nightly_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "debtMarketingReport",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Nightly engagement report",
            "description": "Opens, welcome-message views and link clicks per person"
          }
        }
      }
    ]
  }
}