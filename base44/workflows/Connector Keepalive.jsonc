{
  "description": "Refreshes the shared Google Calendar and Gmail connections every 4 hours so their OAuth grants never go idle long enough to expire",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "connector_keepalive",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "keep_connections_alive": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "connectorKeepalive",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Keep connections alive",
            "description": "Calendar + Gmail"
          }
        }
      }
    ]
  },
  "name": "Connector Keepalive",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */4 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}