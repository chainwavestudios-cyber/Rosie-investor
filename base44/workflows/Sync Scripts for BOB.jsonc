{
  "name": "Sync Scripts for BOB",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_scripts_for_bob",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "getScriptsForBob"
          },
          "then": "end",
          "x-base44": {
            "title": "Sync scripts for BOB",
            "description": "Fetch opener and closer scripts from external endpoint"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */2 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Fetches opener and closer scripts from external endpoint every 2 hours and saves to BOB's knowledge base"
}