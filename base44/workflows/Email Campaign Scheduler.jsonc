{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "email_campaign_scheduler",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_due_campaigns": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "emailCampaignSend",
            "args": {
              "mode": "tick"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send whatever is due",
            "description": "One email per queue, at its own pace"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every 5 minutes, sends the next email of each running CSV campaign once the random wait its queue drew has passed \u2014 inside that campaign's daily window and under its daily limit.",
  "name": "Email Campaign Scheduler"
}